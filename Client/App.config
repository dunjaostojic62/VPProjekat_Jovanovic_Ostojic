<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<appSettings>
			<add key="csvFilePath" value="time_series_15min_singleindex.csv" />
		<add key="countryCode" value="DE" />		
		<add key="selectedDate" value="2015-01-15" />
		<add key="batchSize" value="16" />
		<add key="rejectedFilePath" value="rejected_client.csv" />
		<add key="simulateAbort" value="false" />
	</appSettings>

	<system.serviceModel>
		<client>
		
			<endpoint name="LoadEndpoint"
                      address="net.tcp://localhost:9000/LoadService"
                      binding="netTcpBinding"
                      bindingConfiguration="bigBinding"
                      contract="Common.ILoadService" />
		</client>

		<bindings>
			<netTcpBinding>
				<binding name="bigBinding"
                         maxReceivedMessageSize="2147483647"
                         maxBufferPoolSize="2147483647"
                         openTimeout="00:01:00"
                         closeTimeout="00:01:00"
                         sendTimeout="00:10:00"
                         receiveTimeout="00:10:00">
					<readerQuotas maxArrayLength="2147483647"
                                  maxStringContentLength="2147483647"
                                  maxDepth="64" />
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
</configuration>